{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.avingces.news" }],
      "destination": "https://avingces.news/:path*",
      "permanent": true
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)source' ':(exclude)tools' ':(exclude).github' ':(exclude)README.md'"
}
